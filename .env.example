# Copy to .env and fill in the channels you want. The watcher reads this file automatically;
# unset channels are skipped.

# LLM judge. Set ONE of these; the first one found is used. All except Anthropic have a free tier.
ANTHROPIC_API_KEY=            # console.anthropic.com (paid)
GROQ_API_KEY=                 # console.groq.com -> free, fast, no card. Recommended free option.
GEMINI_API_KEY=               # aistudio.google.com -> free tier
CEREBRAS_API_KEY=             # cloud.cerebras.ai -> free tier
OPENROUTER_API_KEY=           # openrouter.ai -> ":free" models, small daily quota
MISTRAL_API_KEY=              # console.mistral.ai -> free "experiment" tier
# Local model with Ollama (ollama.com): `ollama pull qwen2.5:7b` then just run the watcher.
# OLLAMA_HOST=http://localhost:11434
# LLM_PROVIDER=groq           # force a provider instead of auto-detect
# LLM_MODEL=                  # override the provider's default model name

# Telegram (primary): talk to @BotFather -> /newbot -> token. Then open your bot in Telegram and
# press Start. The chat id is detected automatically from that message; TELEGRAM_CHAT_ID is optional.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Server settings -> Integrations -> Webhooks -> New webhook -> copy URL
DISCORD_WEBHOOK_URL=
DISCORD_MENTION=            # optional, e.g. @everyone or <@your_user_id>

# ntfy (simplest phone push): install the ntfy app, subscribe to a long random topic name, put it here
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# Email (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# Generic JSON webhook (Zapier / Make / n8n / your own endpoint)
GENERIC_WEBHOOK_URL=
