# Copy to .env and fill in the channels you want. Unset channels are skipped automatically.

# Telegram (primary): talk to @BotFather -> /newbot -> token. Then open your bot in Telegram and
# press Start. The chat id is detected automatically from that message; TELEGRAM_CHAT_ID is optional.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Server settings -> Integrations -> Webhooks -> New webhook -> copy URL
DISCORD_WEBHOOK_URL=
DISCORD_MENTION=            # optional, e.g. @everyone or <@your_user_id>

# ntfy (simplest phone push): install the ntfy app, subscribe to a long random topic name, put it here
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# Email (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# Generic JSON webhook (Zapier / Make / n8n / your own endpoint)
GENERIC_WEBHOOK_URL=
